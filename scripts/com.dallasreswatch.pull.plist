<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job: listen for "Pull again" taps on the Tables page (scripts/pull_listener.py).
     Install: cp scripts/com.dallasreswatch.pull.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.dallasreswatch.pull.plist
     Log: ~/.dallas-res-watch/pull.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dallasreswatch.pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>mkdir -p ~/.dallas-res-watch; cd /Users/griffinwright/code/dallas-res-watch &amp;&amp; exec .venv/bin/python -u scripts/pull_listener.py</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/griffinwright/.dallas-res-watch/pull.log</string>
  <key>StandardErrorPath</key><string>/Users/griffinwright/.dallas-res-watch/pull.log</string>
</dict>
</plist>
